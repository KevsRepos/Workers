# Internal URL of the backend (never exposed to browsers).
BACKEND_URL=http://localhost:8080

# Set to "false" only for local development over plain HTTP.
COOKIE_SECURE=false

# adapter-node: public origin and proxy headers (production)
# ORIGIN=https://workers.example.org
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Company data printed on delivery notes
PUBLIC_COMPANY_NAME=Muster Getränke GmbH
PUBLIC_COMPANY_STREET=Musterstraße 1
PUBLIC_COMPANY_POSTAL_CODE=12345
PUBLIC_COMPANY_CITY=Musterstadt
PUBLIC_COMPANY_PHONE=+49 123 456789
PUBLIC_COMPANY_FAX=
PUBLIC_COMPANY_EMAIL=info@example.org
