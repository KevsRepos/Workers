# Public entry point. Only the SvelteKit frontend (BFF) is reachable from the internet;
# the PHP API is served on an internal port that is not published.

server_tokens off;
client_max_body_size 2m;
map_hash_bucket_size 128;

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_req_status 429;

upstream frontend {
    zone frontend 64k;
    server node:3000 resolve;
    keepalive 16;
}

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/access.log combined;

    location = /login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://frontend;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        limit_req zone=general burst=40 nodelay;
        proxy_pass http://frontend;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# Internal API server: only reachable inside the docker network (port not published).
server {
    listen 8080;
    server_name _;

    location = /fpm-ping { return 404; }

    location /api/ {
        include fastcgi_params;
        fastcgi_pass php:9000;
        fastcgi_param SCRIPT_FILENAME /srv/app/public/index.php;
        fastcgi_param DOCUMENT_ROOT /srv/app/public;
        fastcgi_param HTTP_X_REQUEST_ID $http_x_request_id;
        fastcgi_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
