# Copy to .env and fill in. Never commit .env.
DOMAIN=workers.example.org
CERTBOT_EMAIL=admin@example.org

# Generate each with: openssl rand -hex 32
APP_SECRET=
JWT_PASSPHRASE=
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

MARIADB_DATABASE=workers
MARIADB_USER=workers

# e.g. smtp://user:pass@smtp.example.org:587
MAILER_DSN=null://null
MAILER_FROM=workers@example.org

# Printed on delivery notes and time sheets. Logo: deploy/branding/logo.png
COMPANY_NAME=
COMPANY_STREET=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
COMPANY_PHONE=
COMPANY_FAX=
COMPANY_EMAIL=

AUDIT_RETENTION_DAYS=2190
# Time records: min. 2 years after end of year (ArbZG § 16). Longer if used as payroll documents (ask your tax advisor).
TIME_TRACKING_RETENTION_YEARS=2
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
