# Local Symfony defaults only. Replace placeholders before running the backend.
APP_ENV=dev
APP_SECRET=replace-with-a-unique-random-value
DATABASE_URL="mysql://db:replace-with-a-unique-random-value@127.0.0.1:3306/db?serverVersion=mariadb-12.3.3&charset=utf8mb4"
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=replace-with-a-unique-random-value