{
    "name": "workers/backend",
    "description": "Workers \u2013 order, delivery note and time tracking backend (Symfony REST API)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.15",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "lexik/jwt-authentication-bundle": "^3.1",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpstan/phpdoc-parser": "^2.1",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/password-hasher": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfony/clock": "7.4.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.3",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "7.4.*",
        "symfony/maker-bundle": "^1.62",
        "symfony/phpunit-bridge": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "audit": {
            "abandoned": "fail"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*",
        "symfony/browser-kit": ">=8.0",
        "symfony/cache": ">=8.0",
        "symfony/clock": ">=8.0",
        "symfony/config": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/dependency-injection": ">=8.0",
        "symfony/doctrine-bridge": ">=8.0",
        "symfony/dom-crawler": ">=8.0",
        "symfony/dotenv": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/framework-bundle": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/lock": ">=8.0",
        "symfony/mailer": ">=8.0",
        "symfony/messenger": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/monolog-bridge": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/password-hasher": ">=8.0",
        "symfony/phpunit-bridge": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/property-access": ">=8.0",
        "symfony/property-info": ">=8.0",
        "symfony/rate-limiter": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/runtime": ">=8.0",
        "symfony/scheduler": ">=8.0",
        "symfony/security-bundle": ">=8.0",
        "symfony/security-core": ">=8.0",
        "symfony/security-csrf": ">=8.0",
        "symfony/security-http": ">=8.0",
        "symfony/serializer": ">=8.0",
        "symfony/stopwatch": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/validator": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0",
        "symfony/yaml": ">=8.0"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": false
        }
    }
}
