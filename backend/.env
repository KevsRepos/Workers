# Defaults for local development and CI. This file is committed: never put real secrets here.
# Override locally in .env.local (git-ignored); in production use real environment variables.

APP_ENV=dev
APP_SECRET=dev-only-secret-change-me
APP_DEBUG=1

DATABASE_URL="mysql://workers:workers@127.0.0.1:3306/workers?serverVersion=12.3.3-MariaDB&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev-only-passphrase

MAILER_DSN=null://null
MAILER_FROM=workers@localhost
